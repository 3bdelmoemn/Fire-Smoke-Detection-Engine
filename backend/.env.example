# ─── Model ───────────────────────────────────────────────
MODEL_PATH=./app/ml/weights/hf_pretrained_1.pt
CONFIDENCE_THRESHOLD=0.60
IOU_THRESHOLD=0.45
DEVICE=cpu

# ─── Temporal Validation ─────────────────────────────────
MIN_DETECTION_DURATION_SEC=2
MIN_CONSECUTIVE_FRAMES=15
DETECTION_RATIO_THRESHOLD=0.7
ALERT_COOLDOWN_SEC=30

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET_KEY=114
JWT_EXPIRE_MINUTES=60

# ─── WhatsApp Notification ───────────────────────────────
# Only provider credentials here — recipient numbers come from the user's DB record
WHATSAPP_API_KEY=your_api_key_here
WHATSAPP_API_BASE=https://www.wasenderapi.com/api


# ─── Database ─────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db

# ─── Storage ──────────────────────────────────────────────
STORAGE_DIR=./storage
EVAL_DIR=./app/ml/eval/runs/detect

# ─── Camera ───────────────────────────────────────────────
CAMERA_SOURCE=0
CAMERA_FPS=10
FRAME_SKIP=2

# ─── App ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
LOG_LEVEL=INFO
DEBUG=true
